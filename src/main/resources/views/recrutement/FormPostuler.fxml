<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Rectangle?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="recrutement.controllers.FormPostulerController"
      prefWidth="520"
      style="-fx-background-color: #f4f6fb;"
      spacing="0">

    <!-- ══ HEADER ══════════════════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" minHeight="64"
          style="-fx-background-color: white;
                 -fx-border-color: transparent transparent #e8edf5 transparent;
                 -fx-border-width: 0 0 1 0;
                 -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.05),8,0,0,2);">
        <HBox.margin><Insets left="24" right="16" top="0" bottom="0"/></HBox.margin>

        <!-- Accent dot -->
        <Region prefWidth="6" prefHeight="36" minWidth="6" maxWidth="6"
                style="-fx-background-color: linear-gradient(to bottom,#0EA5E9,#38BDF8);
                       -fx-background-radius: 3;"/>

        <VBox spacing="2">
            <HBox.margin><Insets left="14"/></HBox.margin>
            <Label fx:id="formTitle" text="Postuler à un poste"
                   style="-fx-font-family:'Segoe UI'; -fx-font-size:18px;
                          -fx-font-weight:700; -fx-text-fill:#0f172a;"/>
            <Label fx:id="lblTitrePoste" text="Poste : —"
                   style="-fx-font-size:12px; -fx-text-fill:#64748b;"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <Button fx:id="btnClose" text="✕" onAction="#handleClose"
                style="-fx-background-color: #FEE2E2; -fx-text-fill: #DC2626;
                       -fx-font-size:13px; -fx-font-weight:700;
                       -fx-background-radius:8; -fx-cursor:hand;
                       -fx-border-color:transparent; -fx-padding: 6 12 6 12;">
            <HBox.margin><Insets right="16"/></HBox.margin>
        </Button>
    </HBox>

    <!-- ══ BODY ════════════════════════════════════════════════════════ -->
    <VBox spacing="20" VBox.vgrow="ALWAYS">
        <VBox.margin><Insets top="28" left="32" right="32" bottom="0"/></VBox.margin>

        <!-- Info banner -->
        <HBox alignment="CENTER_LEFT" spacing="10"
              style="-fx-background-color: #E0F2FE; -fx-background-radius:10;
                     -fx-padding: 12 16 12 16;">
            <Label text="ℹ️" style="-fx-font-size:16px;"/>
            <Label text="Remplissez ce formulaire pour soumettre votre candidature. Elle sera visible par l'équipe RH."
                   wrapText="true"
                   style="-fx-font-size:12px; -fx-text-fill:#0369A1;"/>
        </HBox>

        <!-- Prénom -->
        <VBox spacing="6">
            <Label text="Prénom *"
                   style="-fx-font-size:13px; -fx-font-weight:700; -fx-text-fill:#374151;"/>
            <TextField fx:id="txtPrenom" promptText="Votre prénom"
                       style="-fx-background-color:white; -fx-background-radius:8;
                              -fx-border-color:#e2e8f0; -fx-border-radius:8;
                              -fx-padding:10 14 10 14; -fx-font-size:13px;"/>
        </VBox>

        <!-- Nom -->
        <VBox spacing="6">
            <Label text="Nom *"
                   style="-fx-font-size:13px; -fx-font-weight:700; -fx-text-fill:#374151;"/>
            <TextField fx:id="txtNom" promptText="Votre nom de famille"
                       style="-fx-background-color:white; -fx-background-radius:8;
                              -fx-border-color:#e2e8f0; -fx-border-radius:8;
                              -fx-padding:10 14 10 14; -fx-font-size:13px;"/>
        </VBox>

        <!-- CV URL -->
        <VBox spacing="6">
            <Label text="Lien vers votre CV"
                   style="-fx-font-size:13px; -fx-font-weight:700; -fx-text-fill:#374151;"/>
            <TextField fx:id="txtCvUrl" promptText="https://... (Google Drive, OneDrive, etc.)"
                       style="-fx-background-color:white; -fx-background-radius:8;
                              -fx-border-color:#e2e8f0; -fx-border-radius:8;
                              -fx-padding:10 14 10 14; -fx-font-size:13px;"/>
            <Label text="Partagez un lien public vers votre CV (PDF recommandé)"
                   style="-fx-font-size:11px; -fx-text-fill:#94a3b8;"/>
        </VBox>

        <!-- Lettre de motivation URL -->
        <VBox spacing="6">
            <Label text="Lien vers votre Lettre de Motivation"
                   style="-fx-font-size:13px; -fx-font-weight:700; -fx-text-fill:#374151;"/>
            <TextField fx:id="txtLettreUrl" promptText="https://... (optionnel)"
                       style="-fx-background-color:white; -fx-background-radius:8;
                              -fx-border-color:#e2e8f0; -fx-border-radius:8;
                              -fx-padding:10 14 10 14; -fx-font-size:13px;"/>
            <Label text="Optionnel mais recommandé pour augmenter vos chances"
                   style="-fx-font-size:11px; -fx-text-fill:#94a3b8;"/>
        </VBox>

    </VBox>

    <!-- ══ FOOTER ══════════════════════════════════════════════════════ -->
    <HBox alignment="CENTER_RIGHT" spacing="10"
          style="-fx-background-color:white;
                 -fx-border-color:#e8edf5 transparent transparent transparent;
                 -fx-border-width:1 0 0 0;">
        <HBox.margin><Insets top="24" left="32" right="32" bottom="24"/></HBox.margin>

        <Button fx:id="btnAnnuler" text="Annuler" onAction="#handleAnnuler"
                style="-fx-background-color:#F1F5F9; -fx-text-fill:#475569;
                       -fx-font-size:13px; -fx-font-weight:600;
                       -fx-background-radius:8; -fx-cursor:hand;
                       -fx-border-color:transparent; -fx-padding:10 24 10 24;"/>

        <Button fx:id="btnEnregistrer" text="📩  Envoyer ma candidature"
                onAction="#handleEnregistrer"
                style="-fx-background-color: linear-gradient(to right,#0EA5E9,#38BDF8);
                       -fx-text-fill:white; -fx-font-size:13px; -fx-font-weight:700;
                       -fx-background-radius:8; -fx-cursor:hand;
                       -fx-border-color:transparent; -fx-padding:10 28 10 28;"/>
    </HBox>

</VBox>
