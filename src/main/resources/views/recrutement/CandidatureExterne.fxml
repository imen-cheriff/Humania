<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.geometry.Insets?>

<BorderPane
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="recrutement.controllers.CandidatureExterneController"
        prefWidth="1200" prefHeight="900"
        style="-fx-background-color: #F5F7FA;">

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                    style="-fx-background-color: #F5F7FA; -fx-background: #F5F7FA; -fx-border-color: transparent;">
            <VBox spacing="0" style="-fx-background-color: #F5F7FA;">
                <padding><Insets top="32" right="40" bottom="40" left="40"/></padding>

                <!-- PAGE HEADER -->
                <HBox alignment="CENTER_LEFT">
                    <VBox HBox.hgrow="ALWAYS" spacing="4">
                        <Label text="Candidatures Externes"
                               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 26px; -fx-font-weight: 700; -fx-text-fill: #0f172a;"/>
                        <Label text="Suivi et gestion des candidats externes"
                               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-text-fill: #64748b;"/>
                    </VBox>
                    <Button fx:id="btnAjouter" text="＋  Nouvelle candidature" onAction="#handleAjouter"
                            style="-fx-background-color: #4F46E5; -fx-text-fill: white; -fx-font-family: 'Segoe UI';
                                   -fx-font-size: 13px; -fx-font-weight: 700; -fx-background-radius: 10;
                                   -fx-padding: 12 22 12 22; -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian, rgba(79,70,229,0.35), 8, 0, 0, 3);"/>
                </HBox>

                <Region prefHeight="24"/>

                <!-- ── KPI STATS ROW ── -->
                <HBox spacing="16">
                    <!-- Total -->
                    <VBox HBox.hgrow="ALWAYS" spacing="0"
                          style="-fx-background-color: white; -fx-background-radius: 14;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 10, 0, 0, 3);">
                        <Region prefHeight="4"
                                style="-fx-background-color: linear-gradient(to right,#4F46E5,#7C3AED);
                                       -fx-background-radius: 14 14 0 0;"/>
                        <VBox spacing="6" style="-fx-padding: 16 20 16 20;">
                            <Label fx:id="statTotal" text="—"
                                   style="-fx-font-size: 28px; -fx-font-weight: 700; -fx-text-fill: #4F46E5;"/>
                            <Label text="Total candidatures"
                                   style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                            <Label text="📋 Toutes les entrées"
                                   style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
                        </VBox>
                    </VBox>
                    <!-- En attente -->
                    <VBox HBox.hgrow="ALWAYS" spacing="0"
                          style="-fx-background-color: white; -fx-background-radius: 14;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 10, 0, 0, 3);">
                        <Region prefHeight="4"
                                style="-fx-background-color: linear-gradient(to right,#F59E0B,#FBBF24);
                                       -fx-background-radius: 14 14 0 0;"/>
                        <VBox spacing="6" style="-fx-padding: 16 20 16 20;">
                            <Label fx:id="statAttente" text="—"
                                   style="-fx-font-size: 28px; -fx-font-weight: 700; -fx-text-fill: #D97706;"/>
                            <Label text="En attente"
                                   style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                            <Label text="⏳ À traiter"
                                   style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
                        </VBox>
                    </VBox>
                    <!-- Acceptées -->
                    <VBox HBox.hgrow="ALWAYS" spacing="0"
                          style="-fx-background-color: white; -fx-background-radius: 14;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 10, 0, 0, 3);">
                        <Region prefHeight="4"
                                style="-fx-background-color: linear-gradient(to right,#10B981,#34D399);
                                       -fx-background-radius: 14 14 0 0;"/>
                        <VBox spacing="6" style="-fx-padding: 16 20 16 20;">
                            <Label fx:id="statAcceptees" text="—"
                                   style="-fx-font-size: 28px; -fx-font-weight: 700; -fx-text-fill: #059669;"/>
                            <Label text="Acceptées"
                                   style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                            <Label text="✅ Recrutements validés"
                                   style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
                        </VBox>
                    </VBox>
                    <!-- Refusées -->
                    <VBox HBox.hgrow="ALWAYS" spacing="0"
                          style="-fx-background-color: white; -fx-background-radius: 14;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 10, 0, 0, 3);">
                        <Region prefHeight="4"
                                style="-fx-background-color: linear-gradient(to right,#EF4444,#F87171);
                                       -fx-background-radius: 14 14 0 0;"/>
                        <VBox spacing="6" style="-fx-padding: 16 20 16 20;">
                            <Label fx:id="statRefusees" text="—"
                                   style="-fx-font-size: 28px; -fx-font-weight: 700; -fx-text-fill: #DC2626;"/>
                            <Label text="Refusées"
                                   style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                            <Label text="❌ Non retenues"
                                   style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
                        </VBox>
                    </VBox>
                    <!-- Entretiens -->
                    <VBox HBox.hgrow="ALWAYS" spacing="0"
                          style="-fx-background-color: white; -fx-background-radius: 14;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 10, 0, 0, 3);">
                        <Region prefHeight="4"
                                style="-fx-background-color: linear-gradient(to right,#3B82F6,#60A5FA);
                                       -fx-background-radius: 14 14 0 0;"/>
                        <VBox spacing="6" style="-fx-padding: 16 20 16 20;">
                            <Label fx:id="statEntretien" text="—"
                                   style="-fx-font-size: 28px; -fx-font-weight: 700; -fx-text-fill: #2563EB;"/>
                            <Label text="En entretien"
                                   style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                            <Label text="🎤 Pipeline actif"
                                   style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
                        </VBox>
                    </VBox>
                </HBox>

                <Region prefHeight="24"/>

                <!-- SEARCH + FILTERS -->
                <HBox prefHeight="52" alignment="CENTER_LEFT" spacing="0"
                      style="-fx-background-color: #ffffff; -fx-background-radius: 12;
                             -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-border-width: 1;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 6, 0, 0, 2);">
                    <Label text="🔍" style="-fx-font-size: 14px; -fx-text-fill: #94a3b8; -fx-padding: 0 0 0 16;"/>
                    <TextField fx:id="txtSearch" promptText="Rechercher un candidat, un poste..."
                               onKeyReleased="#handleSearch" HBox.hgrow="ALWAYS"
                               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px;
                                      -fx-background-color: transparent; -fx-border-color: transparent;
                                      -fx-prompt-text-fill: #94a3b8; -fx-text-fill: #1e293b; -fx-padding: 0 12 0 10;"/>
                    <Separator orientation="VERTICAL" prefHeight="32"/>
                    <ComboBox fx:id="cmbFilterStatut" onAction="#handleFilterStatut"
                              prefWidth="160" prefHeight="52"
                              style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px;
                                     -fx-background-color: transparent; -fx-border-color: transparent;"/>
                    <Separator orientation="VERTICAL" prefHeight="32"/>
                    <ComboBox fx:id="cmbFilterPipeline" onAction="#handleFilterPipeline"
                              prefWidth="160" prefHeight="52"
                              style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px;
                                     -fx-background-color: transparent; -fx-border-color: transparent;"/>
                </HBox>

                <Region prefHeight="20"/>

                <!-- CARDS CONTAINER -->
                <VBox fx:id="cardsContainer" spacing="14"/>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
