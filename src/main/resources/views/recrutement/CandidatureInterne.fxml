<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="recrutement.controllers.CandidatureInterneController"
            prefWidth="1440" prefHeight="900"
            style="-fx-background-color: #F5F7FA;">

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                    style="-fx-background-color: #F5F7FA; -fx-background: #F5F7FA; -fx-border-color: transparent;">
            <VBox spacing="0" style="-fx-background-color: #F5F7FA;">
                <padding><Insets top="32" right="40" bottom="40" left="40"/></padding>

                <!-- PAGE HEADER -->
                <HBox alignment="CENTER_LEFT">
                    <VBox HBox.hgrow="ALWAYS" spacing="4">
                        <Label text="Candidatures Internes"
                               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 26px; -fx-font-weight: 700; -fx-text-fill: #0f172a;"/>
                        <Label text="Mobilité interne — suivi des demandes de changement de poste"
                               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-text-fill: #64748b;"/>
                    </VBox>
                    <Button fx:id="btnAjouter" text="＋  Nouvelle demande" onAction="#handleAjouter"
                            style="-fx-background-color: #7C3AED; -fx-text-fill: white; -fx-font-family: 'Segoe UI';
                                   -fx-font-size: 13px; -fx-font-weight: 700; -fx-background-radius: 10;
                                   -fx-padding: 12 22 12 22; -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian, rgba(124,58,237,0.35), 8, 0, 0, 3);"/>
                </HBox>

                <Region prefHeight="24.0"/>

                <!-- KPI STATS ROW -->
                <HBox spacing="16">
                    <VBox HBox.hgrow="ALWAYS" spacing="0"
                          style="-fx-background-color: white; -fx-background-radius: 14;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 10, 0, 0, 3);">
                        <Region prefHeight="4" style="-fx-background-color: linear-gradient(to right,#7C3AED,#A78BFA); -fx-background-radius: 14 14 0 0;"/>
                        <VBox spacing="6" style="-fx-padding: 16 20 16 20;">
                            <Label fx:id="statTotal" text="—" style="-fx-font-size: 28px; -fx-font-weight: 700; -fx-text-fill: #7C3AED;"/>
                            <Label text="Total demandes" style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                            <Label text="🔄 Mobilité interne" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
                        </VBox>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="0"
                          style="-fx-background-color: white; -fx-background-radius: 14;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 10, 0, 0, 3);">
                        <Region prefHeight="4" style="-fx-background-color: linear-gradient(to right,#F59E0B,#FBBF24); -fx-background-radius: 14 14 0 0;"/>
                        <VBox spacing="6" style="-fx-padding: 16 20 16 20;">
                            <Label fx:id="statAttente" text="—" style="-fx-font-size: 28px; -fx-font-weight: 700; -fx-text-fill: #D97706;"/>
                            <Label text="En attente" style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                            <Label text="⏳ En cours de traitement" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
                        </VBox>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="0"
                          style="-fx-background-color: white; -fx-background-radius: 14;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 10, 0, 0, 3);">
                        <Region prefHeight="4" style="-fx-background-color: linear-gradient(to right,#10B981,#34D399); -fx-background-radius: 14 14 0 0;"/>
                        <VBox spacing="6" style="-fx-padding: 16 20 16 20;">
                            <Label fx:id="statAcceptees" text="—" style="-fx-font-size: 28px; -fx-font-weight: 700; -fx-text-fill: #059669;"/>
                            <Label text="Approuvées" style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                            <Label text="✅ Mutations validées" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
                        </VBox>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="0"
                          style="-fx-background-color: white; -fx-background-radius: 14;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 10, 0, 0, 3);">
                        <Region prefHeight="4" style="-fx-background-color: linear-gradient(to right,#EF4444,#F87171); -fx-background-radius: 14 14 0 0;"/>
                        <VBox spacing="6" style="-fx-padding: 16 20 16 20;">
                            <Label fx:id="statRefusees" text="—" style="-fx-font-size: 28px; -fx-font-weight: 700; -fx-text-fill: #DC2626;"/>
                            <Label text="Refusées" style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                            <Label text="❌ Non approuvées" style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;"/>
                        </VBox>
                    </VBox>
                </HBox>

                <Region prefHeight="24.0"/>

                <!-- SEARCH BAR -->
                <HBox alignment="CENTER" prefHeight="52.0" spacing="0"
                      style="-fx-background-color: #ffffff; -fx-background-radius: 12;
                             -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-border-width: 1;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 6, 0, 0, 2);">
                    <HBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="10">
                        <padding><Insets left="16.0" right="16.0"/></padding>
                        <Label text="🔍" style="-fx-font-size: 14px; -fx-text-fill: #94a3b8;"/>
                        <TextField fx:id="txtSearch" promptText="Rechercher par poste actuel, nouveau poste, motif..."
                                   onKeyReleased="#handleSearch" HBox.hgrow="ALWAYS"
                                   style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px;
                                          -fx-background-color: transparent; -fx-border-color: transparent;
                                          -fx-prompt-text-fill: #94a3b8;"/>
                    </HBox>
                    <Separator orientation="VERTICAL"/>
                    <ComboBox fx:id="cmbFilter" onAction="#handleFilter"
                              prefWidth="180.0" prefHeight="52.0"
                              style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px;
                                     -fx-background-color: transparent; -fx-border-color: transparent;"/>
                </HBox>

                <Region prefHeight="20.0"/>

                <VBox fx:id="cardsContainer" spacing="14"/>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
