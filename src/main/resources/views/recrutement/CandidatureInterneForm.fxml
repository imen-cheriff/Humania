<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Separator?>
<?import javafx.geometry.Insets?>

<BorderPane
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="recrutement.controllers.CandidatureInterneFormController"
        prefWidth="520"
        prefHeight="480"
        style="-fx-background-color: #ffffff; -fx-background-radius: 16; -fx-border-radius: 16;
           -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.18), 24, 0, 0, 6);">

    <top>
        <VBox style="-fx-background-color: #ffffff; -fx-background-radius: 16 16 0 0;">
            <padding><Insets top="24" right="28" bottom="0" left="28"/></padding>
            <HBox alignment="CENTER_LEFT">
                <VBox HBox.hgrow="ALWAYS" spacing="4">
                    <Label fx:id="formTitle" text="Ajouter une Candidature Interne"
                           style="-fx-font-family: 'Segoe UI'; -fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: #0f172a;"/>
                    <Label text="Poste actuel, nouveau poste, salaire et motif"
                           style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                </VBox>
                <Button fx:id="btnClose" text="✕" onAction="#handleClose"
                        style="-fx-background-color: #f1f5f9; -fx-border-color: transparent; -fx-text-fill: #64748b;
                           -fx-font-size: 14px; -fx-font-weight: 700; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 6 10 6 10;"/>
            </HBox>
            <Region prefHeight="20"/>
            <Separator style="-fx-background-color: #e2e8f0;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="14" style="-fx-background-color: #ffffff;">
            <padding><Insets top="20" right="28" bottom="10" left="28"/></padding>

            <HBox spacing="14">
                <VBox HBox.hgrow="ALWAYS" spacing="6">
                    <Label text="POSTE ACTUEL *"
                           style="-fx-font-family: 'Segoe UI'; -fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #64748b;"/>
                    <TextField fx:id="txtPosteActuel" promptText="Ex: Développeur"
                               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-background-color: #f8fafc;
                                  -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 9 12 9 12;"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="6">
                    <Label text="NOUVEAU POSTE *"
                           style="-fx-font-family: 'Segoe UI'; -fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #64748b;"/>
                    <TextField fx:id="txtNouveauPoste" promptText="Ex: Lead Dev"
                               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-background-color: #f8fafc;
                                  -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 9 12 9 12;"/>
                </VBox>
            </HBox>

            <HBox spacing="14">
                <VBox HBox.hgrow="ALWAYS" spacing="6">
                    <Label text="NOUVEAU SALAIRE"
                           style="-fx-font-family: 'Segoe UI'; -fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #64748b;"/>
                    <TextField fx:id="txtNouveauSalaire" promptText="Ex: 45000"
                               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-background-color: #f8fafc;
                                  -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 9 12 9 12;"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="6">
                    <Label text="DATE DEMANDE (AAAA-MM-JJ)"
                           style="-fx-font-family: 'Segoe UI'; -fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #64748b;"/>
                    <TextField fx:id="txtDateDemande" promptText="2026-02-23"
                               style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-background-color: #f8fafc;
                                  -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 9 12 9 12;"/>
                </VBox>
            </HBox>

            <VBox spacing="6">
                <Label text="MOTIF"
                       style="-fx-font-family: 'Segoe UI'; -fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #64748b;"/>
                <TextArea fx:id="txtMotif" promptText="Motif de la candidature..."
                          prefRowCount="4" wrapText="true"
                          style="-fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-background-color: #f8fafc;
                             -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 9 12 9 12;"/>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <VBox style="-fx-background-color: #ffffff; -fx-background-radius: 0 0 16 16;">
            <Separator style="-fx-background-color: #e2e8f0;"/>
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <padding><Insets top="16" right="28" bottom="20" left="28"/></padding>
                <Button fx:id="btnAnnuler" text="Annuler" onAction="#handleClose"
                        style="-fx-background-color: #f1f5f9; -fx-border-color: transparent; -fx-text-fill: #475569;
                           -fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-font-weight: 600;
                           -fx-background-radius: 8; -fx-padding: 10 20 10 20; -fx-cursor: hand;"/>
                <Button fx:id="btnEnregistrer" text="💾  Enregistrer" onAction="#handleEnregistrer"
                        style="-fx-background-color: #3b82f6; -fx-border-color: transparent; -fx-text-fill: white;
                           -fx-font-family: 'Segoe UI'; -fx-font-size: 13px; -fx-font-weight: 700;
                           -fx-background-radius: 8; -fx-padding: 10 22 10 22; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
