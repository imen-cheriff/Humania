<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" alignment="TOP_CENTER" prefWidth="550.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="planification.controllers.AjouterEventCont">
    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <Label text="Formulaire d'Événement" style="-fx-font-weight: bold;">
        <font>
            <Font size="24.0" />
        </font>
    </Label>

    <GridPane hgap="15.0" vgap="15.0">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="120.0" prefWidth="130.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="250.0" />
        </columnConstraints>

        <children>
            <Label text="Titre :" GridPane.rowIndex="0" />
            <TextField fx:id="titreField" promptText="Entrez le titre de l'événement" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Description :" GridPane.rowIndex="1" />
            <TextArea fx:id="descriptionArea" prefHeight="80.0" promptText="Entrez une description (optionnel)" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label text="Date :" GridPane.rowIndex="2" />
            <DatePicker fx:id="datePicker" prefWidth="250.0" promptText="Sélectionner une date" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <Label text="Début :" GridPane.rowIndex="3" />
            <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="3">
                <Spinner fx:id="debutHeureSpinner" editable="true" prefWidth="80.0" />
                <Label text=":" />
                <Spinner fx:id="debutMinuteSpinner" editable="true" prefWidth="80.0" />
            </HBox>

            <Label text="Fin :" GridPane.rowIndex="4" />
            <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="4">
                <Spinner fx:id="finHeureSpinner" editable="true" prefWidth="80.0" />
                <Label text=":" />
                <Spinner fx:id="finMinuteSpinner" editable="true" prefWidth="80.0" />
            </HBox>

            <Label text="Lieu :" GridPane.rowIndex="5" />
            <TextField fx:id="lieuField" promptText="Entrez le lieu de l'événement" GridPane.columnIndex="1" GridPane.rowIndex="5" />

            <Label text="Participants max :" GridPane.rowIndex="6" />
            <Spinner fx:id="participantsMaxSpinner" editable="true" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="6" />
        </children>
    </GridPane>

    <HBox spacing="15.0" alignment="CENTER_RIGHT">
        <Button text="Annuler" fx:id="btnAnnuler" style="-fx-background-color: #f44336; -fx-text-fill: white;" onAction="#annuler" />
        <Button text="Enregistrer l'événement" fx:id="btnEnregistrer" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" onAction="#enregistrerEvenement" />
    </HBox>
</VBox>
