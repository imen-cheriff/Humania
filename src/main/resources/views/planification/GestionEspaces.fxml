<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="800.0" prefWidth="1280.0" spacing="0"
      styleClass="main-container"
      stylesheets="@gestion-espaces.css"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="planification.controllers.GestionEspaCont">

    <!-- ══════════════ HEADER ══════════════ -->
    <HBox alignment="CENTER_LEFT" styleClass="page-header">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label styleClass="page-title" text="Catalogue des Espaces" />
            <Label styleClass="page-subtitle" text="Gérez vos espaces disponibles" />
        </VBox>
        <Button onAction="#handleAjouterEspace" styleClass="btn-add" text="+ Ajouter Espace" />
    </HBox>

    <!-- ══════════════ SEARCH BAR ══════════════ -->
    <HBox styleClass="search-bar-container">
        <VBox.margin><Insets bottom="16" left="28" right="28" top="16" /></VBox.margin>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="search-box">
            <Label styleClass="search-icon" text="🔍" />
            <TextField fx:id="searchField" onKeyReleased="#handleSearch"
                       promptText="Rechercher un espace..."
                       styleClass="search-field" HBox.hgrow="ALWAYS" />
        </HBox>
    </HBox>

    <!-- ══════════════ CARDS AREA ══════════════ -->
    <StackPane fx:id="centerStack" VBox.vgrow="ALWAYS">
        <ScrollPane fitToWidth="true" styleClass="cards-scroll" StackPane.alignment="TOP_LEFT">
            <TilePane fx:id="cardsContainer"
                      alignment="TOP_LEFT"
                      hgap="24" vgap="24"
                      prefColumns="3"
                      prefTileWidth="380.0"
                      prefTileHeight="460.0"
                      styleClass="cards-tile">
                <TilePane.margin><Insets bottom="30" left="28" right="28" top="10" /></TilePane.margin>
            </TilePane>
        </ScrollPane>
    </StackPane>

</VBox>
