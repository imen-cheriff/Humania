<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="800.0" prefWidth="1280.0" spacing="0"
      styleClass="main-container"
      stylesheets="@gestion-evenements.css"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="planification.controllers.GestionEventCont">

    <!-- ══════════════ HEADER ══════════════ -->
    <HBox alignment="CENTER_LEFT" styleClass="page-header">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label styleClass="page-title" text="Gestion des Événements" />
            <Label styleClass="page-subtitle" text="Créez et gérez tous vos événements" />
        </VBox>
        <Button onAction="#handleAjouterEvenement" styleClass="btn-add" text="+ Ajouter Événement" />
    </HBox>

    <!-- ══════════════ SEARCH BAR ══════════════ -->
    <HBox styleClass="search-bar-container">
        <VBox.margin><Insets bottom="16" left="28" right="28" top="16" /></VBox.margin>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="search-box">
            <Label styleClass="search-icon" text="🔍" />
            <TextField fx:id="searchField" onKeyReleased="#handleSearch"
                       promptText="Rechercher un événement..."
                       styleClass="search-field" HBox.hgrow="ALWAYS" />
        </HBox>
    </HBox>

    <!-- ══════════════ CARDS GRID AREA ══════════════ -->
    <StackPane fx:id="centerStack" VBox.vgrow="ALWAYS">
        <ScrollPane fitToWidth="true" styleClass="cards-scroll" StackPane.alignment="TOP_LEFT">
            <GridPane fx:id="cardsContainer"
                      hgap="24" vgap="24"
                      styleClass="cards-grid">
                <GridPane.margin><Insets bottom="30" left="28" right="28" top="10" /></GridPane.margin>
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33" />
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33" />
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33" />
                </columnConstraints>
            </GridPane>
        </ScrollPane>
    </StackPane>

</VBox>
