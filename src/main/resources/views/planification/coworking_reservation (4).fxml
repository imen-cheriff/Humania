<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>

<BorderPane prefHeight="600" prefWidth="950"
            style="-fx-background-color: #FFFFFF;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="planification.controllers.CoworkingController">

    <!-- Header -->
    <top>
        <VBox spacing="6" style="-fx-background-color: #FFFFFF; -fx-padding: 14 24 10 24;">
            <children>
                <Label fx:id="titleLabel"
                       text="Réserver un espace de coworking"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1A1A1A; -fx-font-family: 'Arial';"/>
                <HBox spacing="16" alignment="CENTER_LEFT">
                    <children>
                        <Label text="Espace :"
                               style="-fx-font-size: 13px; -fx-text-fill: #555555;"/>
                        <Label fx:id="espaceNameLabel"
                               text="(non sélectionné)"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #222222;"/>

                        <Label text="Date :"
                               style="-fx-font-size: 13px; -fx-text-fill: #555555; -fx-padding: 0 0 0 32;"/>
                        <DatePicker fx:id="reservationDatePicker"/>

                        <Button fx:id="refreshButton"
                                text="Rafraîchir"
                                style="-fx-background-color: #f2f2f2; -fx-text-fill: #333333; -fx-padding: 6 12; -fx-background-radius: 6;"
                                onAction="#handleRefresh"/>
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <!-- Seats pane and controls -->
    <center>
        <VBox spacing="16" style="-fx-padding: 10 24 16 24;">
            <children>

                <!-- Legend -->
                <HBox spacing="18" alignment="CENTER_LEFT">
                    <children>
                        <Label text="Légende :"
                               style="-fx-font-size: 12px; -fx-text-fill: #666666; -fx-font-weight: bold;"/>

                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <children>
                                <!-- MINE = green circle -->
                                <StackPane prefWidth="20" prefHeight="20">
                                    <children>
                                        <Circle radius="9" fill="#4CAF50" stroke="#FFFFFF" strokeWidth="2"/>
                                    </children>
                                </StackPane>
                                <Label text="Ma réservation" style="-fx-font-size: 12px; -fx-text-fill: #555555;"/>
                            </children>
                        </HBox>

                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <children>
                                <!-- AVAILABLE = yellow circle -->
                                <StackPane prefWidth="20" prefHeight="20">
                                    <children>
                                        <Circle radius="9" fill="#FFC107" stroke="#FFFFFF" strokeWidth="2"/>
                                    </children>
                                </StackPane>
                                <Label text="Disponible" style="-fx-font-size: 12px; -fx-text-fill: #555555;"/>
                            </children>
                        </HBox>

                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <children>
                                <!-- TAKEN = grey circle -->
                                <StackPane prefWidth="20" prefHeight="20">
                                    <children>
                                        <Circle radius="9" fill="#9E9E9E" stroke="#FFFFFF" strokeWidth="2"/>
                                    </children>
                                </StackPane>
                                <Label text="Réservé par un autre" style="-fx-font-size: 12px; -fx-text-fill: #555555;"/>
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <!-- Room visual: scrollable pane where Java draws circles + central rectangle -->
                <ScrollPane fitToWidth="true" fitToHeight="false"
                            style="-fx-background: #FAFAFA; -fx-border-color: #E0E0E0; -fx-border-radius: 10; -fx-background-radius: 10;"
                            hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED">
                    <content>
                        <Pane fx:id="seatsPane"
                              prefWidth="860" prefHeight="400"
                              style="-fx-background-color: #FAFAFA;"/>
                    </content>
                </ScrollPane>

                <!-- Actions -->
                <HBox spacing="12" alignment="CENTER_RIGHT">
                    <children>
                        <Button fx:id="cancelAllButton"
                                text="Annuler mes réservations"
                                style="-fx-background-color: #FFFFFF; -fx-border-color: #DDDDDD; -fx-text-fill: #555555; -fx-padding: 6 14; -fx-background-radius: 6; -fx-border-radius: 6;"
                                onAction="#handleCancelAll"/>
                        <Button fx:id="confirmButton"
                                text="Confirmer"
                                style="-fx-background-color: #2F80ED; -fx-text-fill: white; -fx-padding: 6 18; -fx-background-radius: 6;"
                                onAction="#handleConfirm"/>
                    </children>
                </HBox>

            </children>
        </VBox>
    </center>

    <!-- Footer -->
    <bottom>
        <HBox alignment="CENTER_LEFT" prefHeight="32"
              style="-fx-background-color: #F9F9F9; -fx-padding: 0 24 0 24;">
            <children>
                <Label fx:id="statusLabel"
                       text="Sélectionnez une chaise pour réserver."
                       style="-fx-text-fill: #888888; -fx-font-size: 11px; -fx-font-family: 'Arial';"/>
            </children>
        </HBox>
    </bottom>

</BorderPane>
