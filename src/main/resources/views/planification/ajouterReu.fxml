<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="20.0" alignment="TOP_CENTER" prefWidth="550.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="planification.controllers.AjouterReuCont">
    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <Label text="Ajouter une Réunion" style="-fx-font-weight: bold;">
        <font>
            <Font size="24.0" />
        </font>
    </Label>

    <GridPane hgap="15.0" vgap="15.0">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="120.0" prefWidth="130.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="250.0" />
        </columnConstraints>

        <children>
            <Label text="Titre :" GridPane.rowIndex="0" />
            <TextField fx:id="titreField" promptText="Nom de la réunion" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Description :" GridPane.rowIndex="1" />
            <TextArea fx:id="descriptionArea" prefHeight="70.0" promptText="Objectif..." GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label text="Début :" GridPane.rowIndex="2" />
            <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="2">
                <DatePicker fx:id="dateDebutPicker" promptText="Date" />
                <TextField fx:id="heureDebutField" promptText="HH:mm" prefWidth="70" />
            </HBox>

            <Label text="Fin :" GridPane.rowIndex="3" />
            <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="3">
                <DatePicker fx:id="dateFinPicker" promptText="Date" />
                <TextField fx:id="heureFinField" promptText="HH:mm" prefWidth="70" />
            </HBox>

            <Label text="Type de réunion :" GridPane.rowIndex="4" />
            <CheckBox fx:id="enLigneCheckBox" text="Réunion en ligne (Visioconférence)" onAction="#handleEnLigneToggle" GridPane.columnIndex="1" GridPane.rowIndex="4" />

            <Label text="Choisir la Salle :" GridPane.rowIndex="5" />
            <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="5">
                <ComboBox fx:id="salleComboBox" promptText="-- Sélectionner une salle --" prefWidth="250.0" />
                <Label text="(Non requis si 'En ligne' est coché)" style="-fx-font-size: 10px; -fx-text-fill: gray;" />
            </VBox>

            <Label text="Participants :" GridPane.rowIndex="6" />
            <TextField fx:id="participantsField" promptText="Emails séparés par des virgules" GridPane.columnIndex="1" GridPane.rowIndex="6" />
        </children>
    </GridPane>

    <HBox spacing="15.0" alignment="CENTER_RIGHT">
        <Button text="Annuler" fx:id="btnAnnuler" style="-fx-background-color: #f44336; -fx-text-fill: white;" />
        <Button text="Enregistrer la réunion" fx:id="btnEnregistrer" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" onAction="#handleSave"/>
    </HBox>
</VBox>