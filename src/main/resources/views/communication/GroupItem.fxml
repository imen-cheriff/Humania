<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      styleClass="sidebar-group-item"
      spacing="8"
      alignment="CENTER_LEFT">

    <Label text="👥" style="-fx-font-size: 16px;"/>
    <Label fx:id="groupName" text="Équipe Marketing" HBox.hgrow="ALWAYS"
           style="-fx-font-size: 13px; -fx-font-weight: 500;"/>
    <Label fx:id="groupBadge" styleClass="sidebar-group-badge" text="5"
           visible="false" managed="false"/>

</HBox>