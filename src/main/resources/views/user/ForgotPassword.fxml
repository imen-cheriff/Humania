<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane" style="-fx-background-color: #f0f2f5;"
            prefWidth="1000" prefHeight="600"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="utilisateur.controllers.ForgotPasswordController">
    <center>
        <StackPane>
            <VBox alignment="CENTER" spacing="0" maxWidth="420"
                  style="-fx-background-color: white; -fx-padding: 50 40;
                         -fx-background-radius: 20;
                         -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 20, 0, 0, 5);">

                <!-- ══ STEP 1 — Enter email ══ -->
                <VBox fx:id="step1Pane" spacing="20">
                    <Label text="🔑 Mot de passe oublie ?"
                           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a202c;"/>
                    <Label text="Saisissez votre email. Nous vous enverrons un code de verification."
                           style="-fx-font-size: 13px; -fx-text-fill: #718096; -fx-wrap-text: true;"
                           wrapText="true" maxWidth="340"/>

                    <VBox spacing="8">
                        <Label text="Adresse email"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
                        <HBox alignment="CENTER_LEFT" spacing="0"
                              style="-fx-background-color: #f7fafc; -fx-background-radius: 10;
                                     -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-border-width: 1.5;">
                            <Label text="📧" style="-fx-font-size: 18px; -fx-padding: 0 0 0 15;"/>
                            <TextField fx:id="emailField" promptText="toi@example.com"
                                       HBox.hgrow="ALWAYS"
                                       style="-fx-background-color: transparent; -fx-border-color: transparent;
                                              -fx-padding: 14; -fx-font-size: 14px;"/>
                        </HBox>
                        <Label fx:id="step1ErrorLabel" text=""
                               style="-fx-text-fill: #e53e3e; -fx-font-size: 12px;"/>
                    </VBox>

                    <Button text="Envoyer le code" onAction="#handleSendOtp"
                            prefWidth="340" prefHeight="48"
                            style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2);
                                   -fx-text-fill: white; -fx-font-weight: bold;
                                   -fx-background-radius: 12; -fx-font-size: 14px; -fx-cursor: hand;"/>

                    <Button text="← Retour a la connexion" onAction="#handleBackToLogin"
                            prefWidth="340" prefHeight="40"
                            style="-fx-background-color: transparent; -fx-border-color: #e2e8f0;
                                   -fx-border-radius: 10; -fx-background-radius: 10;
                                   -fx-text-fill: #718096; -fx-font-size: 13px; -fx-cursor: hand;"/>
                </VBox>

                <!-- ══ STEP 2 — Enter OTP ══ -->
                <VBox fx:id="step2Pane" spacing="20" visible="false" managed="false">
                    <Label text="📨 Verifiez votre email"
                           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a202c;"/>
                    <Label fx:id="otpEmailLabel" text=""
                           style="-fx-font-size: 13px; -fx-text-fill: #718096; -fx-wrap-text: true;"
                           wrapText="true" maxWidth="340"/>
                    <Label text="Saisissez le code a 6 chiffres envoye a votre email."
                           style="-fx-font-size: 12px; -fx-text-fill: #a0aec0; -fx-wrap-text: true;"
                           wrapText="true" maxWidth="340"/>

                    <VBox spacing="8">
                        <Label text="Code de verification"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
                        <TextField fx:id="otpField" promptText="000000"
                                   style="-fx-font-size: 28px; -fx-font-weight: bold;
                                          -fx-alignment: center;
                                          -fx-background-color: #f7fafc;
                                          -fx-border-color: #e2e8f0; -fx-border-radius: 10;
                                          -fx-background-radius: 10; -fx-padding: 12;"/>
                        <Label fx:id="step2ErrorLabel" text=""
                               style="-fx-text-fill: #e53e3e; -fx-font-size: 12px;"/>
                    </VBox>

                    <Button text="Verifier le code" onAction="#handleVerifyOtp"
                            prefWidth="340" prefHeight="48"
                            style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2);
                                   -fx-text-fill: white; -fx-font-weight: bold;
                                   -fx-background-radius: 12; -fx-font-size: 14px; -fx-cursor: hand;"/>

                    <HBox spacing="12" alignment="CENTER">
                        <Button text="Renvoyer le code" onAction="#handleResendOtp"
                                style="-fx-background-color: transparent; -fx-text-fill: #667eea;
                                       -fx-font-size: 12px; -fx-cursor: hand; -fx-border-color: transparent;"/>
                        <Button text="← Retour" onAction="#handleBackToStep1"
                                style="-fx-background-color: transparent; -fx-text-fill: #718096;
                                       -fx-font-size: 12px; -fx-cursor: hand; -fx-border-color: transparent;"/>
                    </HBox>
                </VBox>

                <!-- ══ STEP 3 — New password ══ -->
                <VBox fx:id="step3Pane" spacing="20" visible="false" managed="false">
                    <Label text="🔐 Nouveau mot de passe"
                           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a202c;"/>
                    <Label text="Choisissez un nouveau mot de passe securise (min. 6 caracteres)."
                           style="-fx-font-size: 13px; -fx-text-fill: #718096; -fx-wrap-text: true;"
                           wrapText="true" maxWidth="340"/>

                    <VBox spacing="12">
                        <VBox spacing="6">
                            <Label text="Nouveau mot de passe"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
                            <HBox alignment="CENTER_LEFT" spacing="0"
                                  style="-fx-background-color: #f7fafc; -fx-background-radius: 10;
                                         -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-border-width: 1.5;">
                                <Label text="🔒" style="-fx-font-size: 18px; -fx-padding: 0 0 0 15;"/>
                                <PasswordField fx:id="newPasswordField"
                                               promptText="Nouveau mot de passe"
                                               HBox.hgrow="ALWAYS"
                                               style="-fx-background-color: transparent;
                                                      -fx-border-color: transparent; -fx-padding: 14;"/>
                            </HBox>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Confirmer le mot de passe"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
                            <HBox alignment="CENTER_LEFT" spacing="0"
                                  style="-fx-background-color: #f7fafc; -fx-background-radius: 10;
                                         -fx-border-color: #e2e8f0; -fx-border-radius: 10; -fx-border-width: 1.5;">
                                <Label text="🔒" style="-fx-font-size: 18px; -fx-padding: 0 0 0 15;"/>
                                <PasswordField fx:id="confirmPasswordField"
                                               promptText="Confirmer le mot de passe"
                                               HBox.hgrow="ALWAYS"
                                               style="-fx-background-color: transparent;
                                                      -fx-border-color: transparent; -fx-padding: 14;"/>
                            </HBox>
                        </VBox>
                        <Label fx:id="step3ErrorLabel" text=""
                               style="-fx-text-fill: #e53e3e; -fx-font-size: 12px;"/>
                    </VBox>

                    <Button text="Reinitialiser le mot de passe" onAction="#handleResetPassword"
                            prefWidth="340" prefHeight="48"
                            style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2);
                                   -fx-text-fill: white; -fx-font-weight: bold;
                                   -fx-background-radius: 12; -fx-font-size: 14px; -fx-cursor: hand;"/>
                </VBox>

            </VBox>
        </StackPane>
    </center>
</BorderPane>
