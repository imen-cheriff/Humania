<!--                -fx-padding: 7 14;-->
<!--                -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 6, 0, 0, 2);">-->
<!--                <StackPane prefWidth="28" prefHeight="28" style="-->
<!--                    -fx-background-color: #ede9fe; -fx-background-radius: 14;">-->
<!--                    <Label text="👤" style="-fx-font-size: 13;"/>-->
<!--                </StackPane>-->
<!--                <VBox spacing="0" alignment="CENTER_LEFT">-->
<!--                    <Label fx:id="currentUserLabel" text="—"-->
<!--                           style="-fx-font-weight: bold; -fx-font-size: 12; -fx-text-fill: #1a1a2e;"/>-->
<!--                    <Label fx:id="currentEmailLabel" text="—"-->
<!--                           style="-fx-font-size: 10; -fx-text-fill: #9ca3af;"/>-->
<!--                </VBox>-->
<!--            </HBox>-->

<!--            &lt;!&ndash; Mon profil &ndash;&gt;-->
<!--            <Button text="Mon profil" onAction="#handleOpenProfil" style="-->
<!--                -fx-background-color: white;-->
<!--                -fx-border-color: #d1d5db; -fx-border-radius: 20; -fx-background-radius: 20;-->
<!--                -fx-text-fill: #374151; -fx-font-size: 12; -fx-font-weight: bold;-->
<!--                -fx-padding: 8 18; -fx-cursor: hand;-->
<!--                -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 6, 0, 0, 2);"/>-->

<!--            &lt;!&ndash; Archives &ndash;&gt;-->
<!--            <Button text="📦  Archives" onAction="#handleOpenArchives" style="-->
<!--                -fx-background-color: white;-->
<!--                -fx-border-color: #d1d5db; -fx-border-radius: 20; -fx-background-radius: 20;-->
<!--                -fx-text-fill: #374151; -fx-font-size: 12; -fx-font-weight: bold;-->
<!--                -fx-padding: 8 18; -fx-cursor: hand;-->
<!--                -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 6, 0, 0, 2);"/>-->

            <!-- Export PDF -->
            <Button text="📄  PDF" onAction="#handleExportPdf" style="
                -fx-background-color: #fef2f2;
                -fx-border-color: #fca5a5; -fx-border-radius: 20; -fx-background-radius: 20;
                -fx-text-fill: #b91c1c; -fx-font-size: 12; -fx-font-weight: bold;
                -fx-padding: 8 16; -fx-cursor: hand;
                -fx-effect: dropshadow(gaussian, rgba(185,28,28,0.10), 6, 0, 0, 2);"/>

            <!-- Export Excel -->
            <Button text="📊  Excel" onAction="#handleExportExcel" style="
                -fx-background-color: #f0fdf4;
                -fx-border-color: #86efac; -fx-border-radius: 20; -fx-background-radius: 20;
                -fx-text-fill: #15803d; -fx-font-size: 12; -fx-font-weight: bold;
                -fx-padding: 8 16; -fx-cursor: hand;
                -fx-effect: dropshadow(gaussian, rgba(21,128,61,0.10), 6, 0, 0, 2);"/>

<!--            &lt;!&ndash; Add button &ndash;&gt;-->
<!--            <Button text="＋  Candidats acceptés" onAction="#handleAdd" style="-->
