<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="0" style="-fx-background-color: #f5f6fa;" xmlns:fx="http://javafx.com/fxml"
      fx:controller="utilisateur.controllers.GestionUtilisateurController">

    <!-- Top accent bar -->
    <HBox prefHeight="4" style="-fx-background-color: linear-gradient(to right, #7c3aed, #6366f1, #38bdf8);"/>

    <!-- ══════════════════════════════════════════ -->
    <!-- HERO HEADER BANNER                         -->
    <!-- ══════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" style="
        -fx-background-color: linear-gradient(to right, #ffffff, #f5f3ff);
        -fx-border-color: transparent transparent #e9e4fb transparent;
        -fx-border-width: 0 0 1 0;
        -fx-padding: 20 28 20 28;">

        <!-- Icon badge -->
        <StackPane prefWidth="52" prefHeight="52" style="
            -fx-background-color: linear-gradient(to bottom right, #7c3aed, #6366f1);
            -fx-background-radius: 14;
            -fx-effect: dropshadow(gaussian, rgba(124,58,237,0.28), 10, 0, 0, 3);">
            <Label text="👥" style="-fx-font-size: 22;"/>
        </StackPane>

        <VBox spacing="3" style="-fx-padding: 0 0 0 14;">
            <Label text="Gestion des utilisateurs" style="-fx-text-fill: #1a1a2e;">
                <font><Font name="System Bold" size="20"/></font>
            </Label>
            <HBox spacing="6" alignment="CENTER_LEFT">
                <Label text="●" style="-fx-text-fill: #7c3aed; -fx-font-size: 8;"/>
                <Label fx:id="countLabel" text="0 utilisateur trouvé"
                       style="-fx-text-fill: #6b7280; -fx-font-size: 12;"/>
            </HBox>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <!-- Right: user info + action buttons -->
        <HBox alignment="CENTER_RIGHT" spacing="10">

            <!-- Current user info pill -->
