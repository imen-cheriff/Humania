<!--                -fx-background-radius: 20; -fx-padding: 9 20; -fx-cursor: hand;-->
<!--                -fx-effect: dropshadow(gaussian, rgba(99,102,241,0.30), 10, 0, 0, 3);"/>-->
        </HBox>
    </HBox>

    <!-- ══════════════════════════════════════════ -->
    <!-- FILTERS BAR                                -->
    <!-- ══════════════════════════════════════════ -->
    <HBox spacing="12" alignment="CENTER_LEFT" style="
        -fx-background-color: white;
        -fx-border-color: transparent transparent #f0f0f5 transparent;
        -fx-border-width: 0 0 1 0;
        -fx-padding: 14 28 14 28;">

        <!-- Search icon + field wrapper -->
        <HBox alignment="CENTER_LEFT" spacing="0" style="
            -fx-background-color: #f9fafb;
            -fx-border-color: #e5e7eb; -fx-border-radius: 10; -fx-background-radius: 10;
            -fx-border-width: 1; -fx-padding: 0 12 0 12;">
            <Label text="🔍" style="-fx-font-size: 13; -fx-text-fill: #9ca3af;"/>
            <TextField fx:id="searchField"
                       promptText="Rechercher par nom, prénom, username, email ou téléphone..."
                       prefWidth="380"
                       style="
                           -fx-background-color: transparent;
                           -fx-border-color: transparent;
                           -fx-background-radius: 10;
                           -fx-padding: 8 8 8 8;
                           -fx-font-size: 13;
                           -fx-text-fill: #111827;
                           -fx-prompt-text-fill: #9ca3af;"/>
        </HBox>

        <ComboBox fx:id="roleFilter" prefWidth="190" promptText="Filtrer par rôle" style="
            -fx-background-color: #f9fafb;
            -fx-border-color: #e5e7eb; -fx-border-radius: 10; -fx-background-radius: 10;
            -fx-border-width: 1; -fx-font-size: 13; -fx-padding: 4 8;"/>
    </HBox>

    <!-- ══════════════════════════════════════════ -->
    <!-- CARDS GRID                                 -->
    <!-- ══════════════════════════════════════════ -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="
        -fx-background: transparent;
        -fx-background-color: transparent;
        -fx-border-color: transparent;">
        <FlowPane fx:id="cardsGrid" hgap="18" vgap="18" minHeight="300" prefWrapLength="900">
            <padding><Insets top="22" right="28" bottom="22" left="28"/></padding>
        </FlowPane>
    </ScrollPane>

    <!-- ══════════════════════════════════════════ -->
    <!-- PAGINATION BAR                             -->
    <!-- ══════════════════════════════════════════ -->
    <HBox spacing="10" alignment="CENTER_RIGHT" style="
        -fx-background-color: white;
        -fx-border-color: #f0f0f5 transparent transparent transparent;
        -fx-border-width: 1 0 0 0;
        -fx-padding: 12 28 12 28;">
        <Label fx:id="pageLabel" text="Page 1 sur 1"
               style="-fx-text-fill: #6b7280; -fx-font-size: 12;"/>
        <Button fx:id="prevBtn" text="◀" onAction="#handlePrevPage" style="
            -fx-background-color: white;
            -fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-background-radius: 8;
            -fx-text-fill: #374151; -fx-padding: 6 12; -fx-cursor: hand;
            -fx-font-size: 11;"/>
        <Button fx:id="nextBtn" text="▶" onAction="#handleNextPage" style="
            -fx-background-color: white;
            -fx-border-color: #d1d5db; -fx-border-radius: 8; -fx-background-radius: 8;
            -fx-text-fill: #374151; -fx-padding: 6 12; -fx-cursor: hand;
            -fx-font-size: 11;"/>
    </HBox>

</VBox>
