<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            xmlns="http://javafx.com/javafx/17"
            fx:controller="competence.controllers.TrainingCatalogController"
            fitToWidth="true"
            style="-fx-background:#F5F7FA; -fx-background-color:#F5F7FA; -fx-border-color:transparent;">

    <VBox spacing="20" style="-fx-padding:30; -fx-background-color:#F5F7FA;">

        <!-- ══════════════ HEADER ═════════════════════════════════════ -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label text="Training Catalog"
                       style="-fx-font-size:28;-fx-font-weight:bold;-fx-text-fill:#111827;"/>
                <Label text="Browse and enroll in available training programs"
                       style="-fx-font-size:14;-fx-text-fill:#6C757D;"/>
            </VBox>

            <!-- ★ AI Assistant — ouverture UNIQUEMENT au clic, jamais auto -->
            <Button text="✦  AI Assistant"
                    onAction="#handleAiAssistant"
                    style="-fx-background-color:linear-gradient(to right,#6366F1,#8B5CF6);
                           -fx-text-fill:white;-fx-font-weight:bold;-fx-font-size:12;
                           -fx-padding:11 20;-fx-background-radius:22;-fx-cursor:hand;
                           -fx-effect:dropshadow(gaussian,rgba(99,102,241,0.35),10,0,0,3);"/>

            <Button fx:id="btnCreateTraining"
                    text="＋  New Training"
                    onAction="#handleCreateTraining"
                    style="-fx-background-color:#2563EB;-fx-text-fill:white;
                           -fx-font-weight:bold;-fx-font-size:13;
                           -fx-padding:12 24;-fx-background-radius:8;-fx-cursor:hand;"/>
        </HBox>

        <!-- ══════════════ STATS CARDS ════════════════════════════════ -->
        <GridPane hgap="20" vgap="20">
            <columnConstraints>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
            </columnConstraints>

            <!-- Total Formations -->
            <VBox GridPane.columnIndex="0" spacing="0"
                  style="-fx-background-color:white;-fx-background-radius:12;
                         -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.08),10,0,0,2);">
                <Region prefHeight="5"
                        style="-fx-background-color:#10B981;-fx-background-radius:12 12 0 0;"/>
                <VBox spacing="12" style="-fx-padding:18 20 18 20;">
                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <Label text="📚"
                               style="-fx-font-size:20;-fx-background-color:#D1FAE5;
                                      -fx-padding:10;-fx-background-radius:8;"/>
                        <VBox spacing="3">
                            <Label fx:id="lblTotalTrainings" text="0"
                                   style="-fx-font-size:32;-fx-font-weight:bold;-fx-text-fill:#111827;"/>
                            <Label text="Total Formations"
                                   style="-fx-font-size:12;-fx-text-fill:#6B7280;"/>
                        </VBox>
                    </HBox>
                    <Label text="📈  Catalogue complet"
                           style="-fx-font-size:11;-fx-text-fill:#10B981;-fx-font-weight:bold;"/>
                </VBox>
            </VBox>

            <!-- E-Learning -->
            <VBox GridPane.columnIndex="1" spacing="0"
                  style="-fx-background-color:white;-fx-background-radius:12;
                         -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.08),10,0,0,2);">
                <Region prefHeight="5"
                        style="-fx-background-color:#2563EB;-fx-background-radius:12 12 0 0;"/>
                <VBox spacing="12" style="-fx-padding:18 20 18 20;">
                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <Label text="💻"
                               style="-fx-font-size:20;-fx-background-color:#EFF6FF;
                                      -fx-padding:10;-fx-background-radius:8;"/>
                        <VBox spacing="3">
                            <Label fx:id="lblELearning" text="0"
                                   style="-fx-font-size:32;-fx-font-weight:bold;-fx-text-fill:#111827;"/>
                            <Label text="E-Learning"
                                   style="-fx-font-size:12;-fx-text-fill:#6B7280;"/>
                        </VBox>
                    </HBox>
                    <Label text="🖥️  Formations en ligne"
                           style="-fx-font-size:11;-fx-text-fill:#2563EB;-fx-font-weight:bold;"/>
                </VBox>
            </VBox>

            <!-- Classroom -->
            <VBox GridPane.columnIndex="2" spacing="0"
                  style="-fx-background-color:white;-fx-background-radius:12;
                         -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.08),10,0,0,2);">
                <Region prefHeight="5"
                        style="-fx-background-color:#D97706;-fx-background-radius:12 12 0 0;"/>
                <VBox spacing="12" style="-fx-padding:18 20 18 20;">
                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <Label text="🏫"
                               style="-fx-font-size:20;-fx-background-color:#FEF3C7;
                                      -fx-padding:10;-fx-background-radius:8;"/>
                        <VBox spacing="3">
                            <Label fx:id="lblClassroom" text="0"
                                   style="-fx-font-size:32;-fx-font-weight:bold;-fx-text-fill:#111827;"/>
                            <Label text="Classroom"
                                   style="-fx-font-size:12;-fx-text-fill:#6B7280;"/>
                        </VBox>
                    </HBox>
                    <Label text="🏫  Formations présentiel"
                           style="-fx-font-size:11;-fx-text-fill:#D97706;-fx-font-weight:bold;"/>
                </VBox>
            </VBox>

            <!-- Categories -->
            <VBox GridPane.columnIndex="3" spacing="0"
                  style="-fx-background-color:white;-fx-background-radius:12;
                         -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.08),10,0,0,2);">
                <Region prefHeight="5"
                        style="-fx-background-color:#7C3AED;-fx-background-radius:12 12 0 0;"/>
                <VBox spacing="12" style="-fx-padding:18 20 18 20;">
                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <Label text="🎓"
                               style="-fx-font-size:20;-fx-background-color:#F3E8FF;
                                      -fx-padding:10;-fx-background-radius:8;"/>
                        <VBox spacing="3">
                            <Label fx:id="lblCategories" text="0"
                                   style="-fx-font-size:32;-fx-font-weight:bold;-fx-text-fill:#111827;"/>
                            <Label text="Catégories"
                                   style="-fx-font-size:12;-fx-text-fill:#6B7280;"/>
                        </VBox>
                    </HBox>
                    <Label text="🗂️  Domaines de compétence"
                           style="-fx-font-size:11;-fx-text-fill:#7C3AED;-fx-font-weight:bold;"/>
                </VBox>
            </VBox>
        </GridPane>

        <!-- ══════════════ BARRE FILTRES ══════════════════════════════ -->
        <HBox spacing="12" alignment="CENTER_LEFT"
              style="-fx-background-color:white;-fx-padding:14 16;-fx-background-radius:12;
                     -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.05),8,0,0,2);
                     -fx-border-color:#F3F4F6;-fx-border-width:1;-fx-border-radius:12;">

            <Label text="🔍" style="-fx-font-size:16;"/>
            <TextField fx:id="searchTrainingsField"
                       promptText="Rechercher une formation..."
                       prefWidth="260"
                       style="-fx-background-color:#F5F7FA;-fx-border-radius:8;
                              -fx-background-radius:8;-fx-padding:8 12;-fx-font-size:12;"/>

            <ComboBox fx:id="cbFilterType"
                      prefWidth="140"
                      style="-fx-background-color:#F5F7FA;-fx-border-radius:8;-fx-background-radius:8;"/>

            <ComboBox fx:id="cbFilterCategory"
                      prefWidth="160"
                      style="-fx-background-color:#F5F7FA;-fx-border-radius:8;-fx-background-radius:8;"/>

            <ComboBox fx:id="cbFilterStatus"
                      prefWidth="130"
                      style="-fx-background-color:#F5F7FA;-fx-border-radius:8;-fx-background-radius:8;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="✕ Réinitialiser"
                    onAction="#handleClearFilters"
                    style="-fx-background-color:transparent;-fx-text-fill:#9CA3AF;
                           -fx-font-size:11;-fx-cursor:hand;-fx-padding:6 12;
                           -fx-background-radius:8;-fx-border-color:#E5E7EB;
                           -fx-border-width:1;-fx-border-radius:8;"/>
        </HBox>

        <!-- ══════════════ CONTENU PRINCIPAL ══════════════════════════
             Le controller construit dynamiquement :
             - Section "Mes Formations" (si inscrit à au moins 1)
             - Section "Toutes les formations" (catalogue)
             Les deux sont injectées dans vboxTrainingsList.
        ═══════════════════════════════════════════════════════════════ -->
        <VBox fx:id="vboxTrainingsList" spacing="14"/>

        <!-- État vide (géré par le controller) -->
        <VBox fx:id="vboxEmpty" visible="false" managed="false"
              alignment="CENTER" spacing="16"
              style="-fx-padding:60;">
            <Label text="🔍"  style="-fx-font-size:48;"/>
            <Label text="Aucune formation ne correspond à vos critères."
                   style="-fx-font-size:14;-fx-text-fill:#9CA3AF;-fx-font-weight:bold;"/>
            <Button text="Réinitialiser les filtres"
                    onAction="#handleClearFilters"
                    style="-fx-background-color:#4F46E5;-fx-text-fill:white;
                           -fx-font-weight:bold;-fx-padding:10 24;-fx-background-radius:10;-fx-cursor:hand;"/>
        </VBox>

    </VBox>
</ScrollPane>
