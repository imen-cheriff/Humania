<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="competence.controllers.ModuleLearnerController"
            style="-fx-background-color:#F5F7FF;">

    <!-- ═══════════════════  TOP BAR — claire et colorée  ═══════════════════ -->
    <top>
        <VBox style="-fx-background-color:white;
                     -fx-effect:dropshadow(gaussian,rgba(99,102,241,0.13),18,0,0,5);
                     -fx-border-color:#E0E7FF;-fx-border-width:0 0 1.5 0;">

            <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-padding:13 28;">

                <!-- Bouton retour -->
                <Button fx:id="btnClose" text="← Retour" onAction="#handleClose"
                        style="-fx-background-color:#EEF2FF;-fx-text-fill:#4F46E5;
                               -fx-font-size:12;-fx-font-weight:bold;-fx-cursor:hand;
                               -fx-padding:8 18;-fx-border-color:#C7D2FE;
                               -fx-border-radius:10;-fx-background-radius:10;-fx-border-width:1.5;"/>

                <Region style="-fx-background-color:#E0E7FF;
                               -fx-min-width:1.5;-fx-min-height:28;-fx-max-width:1.5;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Titre centré -->
                <VBox spacing="3" alignment="CENTER">
                    <Label fx:id="lblModuleTitle" text="Module"
                           style="-fx-font-size:15;-fx-font-weight:bold;-fx-text-fill:#1E1B4B;"/>
                    <Label fx:id="lblModuleType" text="📖  lecture"
                           style="-fx-font-size:11;-fx-text-fill:#6366F1;-fx-font-weight:bold;
                                  -fx-background-color:#EEF2FF;-fx-padding:2 10;
                                  -fx-background-radius:20;"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Pill progression -->
                <Label fx:id="lblProgress" text="0 % complété"
                       style="-fx-font-size:11;-fx-font-weight:bold;-fx-text-fill:#7C3AED;
                              -fx-background-color:#F5F3FF;-fx-padding:6 16;
                              -fx-background-radius:20;-fx-border-color:#DDD6FE;
                              -fx-border-width:1.5;-fx-border-radius:20;"/>

                <!-- Bouton terminer -->
                <Button fx:id="btnMarkComplete" text="✓  Terminer le module" onAction="#handleMarkComplete"
                        style="-fx-background-color:linear-gradient(to right,#6366F1,#8B5CF6);
                               -fx-text-fill:white;-fx-font-weight:bold;-fx-font-size:12;
                               -fx-padding:9 22;-fx-background-radius:12;-fx-cursor:hand;
                               -fx-effect:dropshadow(gaussian,rgba(99,102,241,0.45),12,0,0,4);"/>
            </HBox>

            <!-- Barre de progression colorée -->
            <StackPane prefHeight="5">
                <Region maxWidth="Infinity" prefHeight="5" style="-fx-background-color:#EEF2FF;"/>
                <ProgressBar fx:id="progressBar" progress="0" prefHeight="5"
                             maxWidth="Infinity" StackPane.alignment="CENTER_LEFT"
                             style="-fx-accent:#818CF8;-fx-background-color:transparent;-fx-padding:0;"/>
            </StackPane>
        </VBox>
    </top>

    <!-- ═══════════════════  BODY : contenu + sidebar  ═══════════════════ -->
    <center>
        <HBox spacing="0">

            <!-- ── Zone contenu principale ── -->
            <VBox HBox.hgrow="ALWAYS" spacing="0" style="-fx-background-color:#F5F7FF;">

                <StackPane fx:id="contentContainer" VBox.vgrow="ALWAYS"
                           style="-fx-background-color:#F5F7FF;">

                    <WebView fx:id="videoPlayer" prefHeight="720" maxHeight="Infinity"
                             visible="false" managed="false"/>

                    <ScrollPane fx:id="courseScrollPane" fitToWidth="true"
                                visible="false" managed="false"
                                style="-fx-background:#F5F7FF;-fx-background-color:#F5F7FF;
                                       -fx-border-color:transparent;
                                       -fx-focus-color:transparent;-fx-faint-focus-color:transparent;">
                        <VBox fx:id="courseContent" spacing="0"
                              style="-fx-background-color:#F5F7FF;-fx-padding:0;"/>
                    </ScrollPane>

                </StackPane>

                <!-- Barre navigation bas -->
                <HBox alignment="CENTER" spacing="16"
                      style="-fx-padding:13 32;-fx-background-color:white;
                             -fx-border-color:#E0E7FF;-fx-border-width:1.5 0 0 0;
                             -fx-effect:dropshadow(gaussian,rgba(99,102,241,0.07),8,0,-2,0);">

                    <Button fx:id="btnPrevious" text="← Précédent" onAction="#handlePrevious"
                            style="-fx-background-color:#EEF2FF;-fx-text-fill:#6366F1;
                                   -fx-font-size:13;-fx-font-weight:bold;-fx-padding:10 22;
                                   -fx-border-color:#C7D2FE;-fx-border-radius:12;
                                   -fx-background-radius:12;-fx-cursor:hand;-fx-border-width:1.5;"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <!-- Astuce centrale -->
                    <HBox alignment="CENTER" spacing="6"
                          style="-fx-background-color:#FFF7ED;-fx-padding:7 16;
                                 -fx-background-radius:20;-fx-border-color:#FED7AA;
                                 -fx-border-width:1;-fx-border-radius:20;">
                        <Label text="💡" style="-fx-font-size:12;"/>
                        <Label text="Clic droit sur le texte pour surligner"
                               style="-fx-font-size:11;-fx-text-fill:#92400E;-fx-font-style:italic;"/>
                    </HBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button fx:id="btnNext" text="Suivant →" onAction="#handleNext"
                            style="-fx-background-color:linear-gradient(to right,#6366F1,#818CF8);
                                   -fx-text-fill:white;-fx-font-weight:bold;-fx-font-size:13;
                                   -fx-padding:10 28;-fx-background-radius:12;-fx-cursor:hand;
                                   -fx-effect:dropshadow(gaussian,rgba(99,102,241,0.4),10,0,0,3);"/>
                </HBox>
            </VBox>

            <!-- ══════════════  SIDEBAR DROITE  ══════════════ -->
            <VBox fx:id="sidebarPanel" spacing="0" prefWidth="330"
                  style="-fx-background-color:white;
                         -fx-border-color:#E0E7FF;-fx-border-width:0 0 0 1.5;">

                <!-- Onglets -->
                <HBox spacing="0" style="-fx-background-color:#F8F9FF;
                                         -fx-border-color:#E0E7FF;-fx-border-width:0 0 1.5 0;">
                    <Button fx:id="btnTabNotes" text="✏  Notes" onAction="#switchToNotes"
                            style="-fx-background-color:#6366F1;-fx-text-fill:white;-fx-font-size:11;
                                   -fx-font-weight:bold;-fx-padding:13 0;-fx-background-radius:0;-fx-cursor:hand;"
                            maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    <Region style="-fx-background-color:#E0E7FF;-fx-min-width:1;-fx-max-width:1;"/>
                    <Button fx:id="btnTabAI" text="🤖  IA" onAction="#switchToAI"
                            style="-fx-background-color:#F8F9FF;-fx-text-fill:#94A3B8;-fx-font-size:11;
                                   -fx-font-weight:bold;-fx-padding:13 0;-fx-background-radius:0;-fx-cursor:hand;"
                            maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    <Region style="-fx-background-color:#E0E7FF;-fx-min-width:1;-fx-max-width:1;"/>
                    <Button fx:id="btnTabVideos" text="🎬  Vidéos" onAction="#switchToVideos"
                            style="-fx-background-color:#F8F9FF;-fx-text-fill:#94A3B8;-fx-font-size:11;
                                   -fx-font-weight:bold;-fx-padding:13 0;-fx-background-radius:0;-fx-cursor:hand;"
                            maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                </HBox>

                <!-- ── PANEL NOTES ── -->
                <VBox fx:id="panelNotes" spacing="0" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding:14 18 8 18;">
                        <Label text="📝" style="-fx-font-size:15;"/>
                        <Label text="Mes notes" style="-fx-font-size:13;-fx-font-weight:bold;-fx-text-fill:#1E1B4B;"/>
                    </HBox>
                    <VBox spacing="10" style="-fx-padding:0 16 14 16;-fx-border-color:#E0E7FF;-fx-border-width:0 0 1.5 0;">
                        <TextArea fx:id="txtNotes" promptText="Capturez vos idées, questions, remarques…"
                                  prefRowCount="4" wrapText="true"
                                  style="-fx-background-color:#F8F9FF;-fx-text-fill:#1E1B4B;
                                         -fx-border-color:#C7D2FE;-fx-border-radius:10;
                                         -fx-background-radius:10;-fx-font-size:13;-fx-padding:11;"/>
                        <Button fx:id="btnSaveNote" text="💾  Enregistrer la note" onAction="#saveNote"
                                maxWidth="Infinity"
                                style="-fx-background-color:linear-gradient(to right,#6366F1,#8B5CF6);
                                       -fx-text-fill:white;-fx-font-weight:bold;-fx-font-size:12;
                                       -fx-padding:10;-fx-background-radius:10;-fx-cursor:hand;
                                       -fx-effect:dropshadow(gaussian,rgba(99,102,241,0.3),8,0,0,3);"/>
                    </VBox>
                    <HBox style="-fx-padding:12 18 6 18;">
                        <Label text="HISTORIQUE" style="-fx-font-size:9.5;-fx-text-fill:#94A3B8;-fx-font-weight:bold;"/>
                    </HBox>
                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                                style="-fx-background:transparent;-fx-background-color:transparent;
                                       -fx-border-color:transparent;-fx-focus-color:transparent;-fx-faint-focus-color:transparent;">
                        <VBox fx:id="notesHistory" spacing="8" style="-fx-padding:0 14 24 14;"/>
                    </ScrollPane>
                </VBox>

                <!-- ── PANEL IA ── -->
                <VBox fx:id="panelAI" spacing="0" VBox.vgrow="ALWAYS" visible="false" managed="false">
                    <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding:14 18 8 18;">
                        <Label text="🤖" style="-fx-font-size:18;"/>
                        <VBox spacing="1">
                            <Label text="Assistant IA" style="-fx-font-size:13;-fx-font-weight:bold;-fx-text-fill:#1E1B4B;"/>
                            <Label text="Propulsé par Gemini 2.0" style="-fx-font-size:10;-fx-text-fill:#94A3B8;"/>
                        </VBox>
                    </HBox>
                    <VBox spacing="8" style="-fx-padding:0 16 14 16;-fx-border-color:#E0E7FF;-fx-border-width:0 0 1.5 0;">
                        <Button fx:id="btnAISummary" text="✨  Résumer ce module"
                                onAction="#handleAISummary" maxWidth="Infinity"
                                style="-fx-background-color:linear-gradient(to right,#6366F1,#8B5CF6);
                                       -fx-text-fill:white;-fx-font-weight:bold;-fx-font-size:12;
                                       -fx-padding:11;-fx-background-radius:10;-fx-cursor:hand;
                                       -fx-effect:dropshadow(gaussian,rgba(99,102,241,0.3),8,0,0,3);"/>
                        <HBox spacing="8">
                            <Button fx:id="btnAIExplain" text="💡  Simplifier"
                                    onAction="#handleAIExplain" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                    style="-fx-background-color:#EEF2FF;-fx-text-fill:#4F46E5;-fx-font-weight:bold;
                                           -fx-font-size:12;-fx-padding:10;-fx-background-radius:10;
                                           -fx-border-color:#C7D2FE;-fx-border-width:1.5;-fx-border-radius:10;-fx-cursor:hand;"/>
                            <Button fx:id="btnAIQuiz" text="❓  Quiz"
                                    onAction="#handleAIGenerateQuestions" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                    style="-fx-background-color:#F0FDF4;-fx-text-fill:#059669;-fx-font-weight:bold;
                                           -fx-font-size:12;-fx-padding:10;-fx-background-radius:10;
                                           -fx-border-color:#A7F3D0;-fx-border-width:1.5;-fx-border-radius:10;-fx-cursor:hand;"/>
                        </HBox>
                        <Label fx:id="lblAIStatus" text="" style="-fx-font-size:10;-fx-text-fill:#6366F1;-fx-font-style:italic;"/>
                    </VBox>
                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                                style="-fx-background:transparent;-fx-background-color:transparent;
                                       -fx-border-color:transparent;-fx-focus-color:transparent;-fx-faint-focus-color:transparent;">
                        <VBox fx:id="aiResponseContainer" spacing="10" style="-fx-padding:12 14 24 14;"/>
                    </ScrollPane>
                </VBox>

                <!-- ── PANEL VIDÉOS ── -->
                <VBox fx:id="panelVideos" spacing="0" VBox.vgrow="ALWAYS" visible="false" managed="false">
                    <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding:14 18 8 18;">
                        <Label text="🎬" style="-fx-font-size:18;"/>
                        <VBox spacing="1">
                            <Label text="Vidéos YouTube" style="-fx-font-size:13;-fx-font-weight:bold;-fx-text-fill:#1E1B4B;"/>
                            <Label text="Ressources liées à ce module" style="-fx-font-size:10;-fx-text-fill:#94A3B8;"/>
                        </VBox>
                    </HBox>
                    <VBox spacing="8" style="-fx-padding:0 16 14 16;-fx-border-color:#E0E7FF;-fx-border-width:0 0 1.5 0;">
                        <Button fx:id="btnSearchVideos" text="🔍  Chercher des vidéos"
                                onAction="#handleSearchVideos" maxWidth="Infinity"
                                style="-fx-background-color:linear-gradient(to right,#EF4444,#DC2626);
                                       -fx-text-fill:white;-fx-font-weight:bold;-fx-font-size:12;
                                       -fx-padding:11;-fx-background-radius:10;-fx-cursor:hand;
                                       -fx-effect:dropshadow(gaussian,rgba(220,38,38,0.3),8,0,0,3);"/>
                        <Label fx:id="lblVideoStatus"
                               text="Cliquez pour trouver des ressources vidéo liées à ce module."
                               style="-fx-font-size:11;-fx-text-fill:#94A3B8;-fx-font-style:italic;" wrapText="true"/>
                    </VBox>
                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                                style="-fx-background:transparent;-fx-background-color:transparent;
                                       -fx-border-color:transparent;-fx-focus-color:transparent;-fx-faint-focus-color:transparent;">
                        <VBox fx:id="videoResultsContainer" spacing="10" style="-fx-padding:12 14 24 14;"/>
                    </ScrollPane>
                </VBox>

            </VBox>
        </HBox>
    </center>

</BorderPane>
